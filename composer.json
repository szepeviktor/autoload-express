{
  "name": "szepeviktor/autoload-express",
  "type": "wordpress-muplugin",
  "require": {
    "php": ">=8.1",
    "composer/class-map-generator": "^1.6",
    "symfony/finder": "^6.4"
  },
  "autoload": {
    "psr-4": {"RoboViktor\\AutoloadClassmap\\": "src/"}
  },
  "config": {"optimize-autoloader": true, "classmap-authoritative": true}
}
